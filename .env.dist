# PostgreSQL Read-Only MCP : environment configuration
# Copy to .env and fill in your credentials. Never commit .env.
#
# Each environment is optional: if POSTGRES_{ENV}_HOST is absent, the env is skipped.
# SSL defaults to true when not set (recommended for cloud databases).
# Supported environments: staging, test, prod.

# ---------------------------------------------------------------------------
# HTTP server (only used when PORT is set, ignored in stdio mode)
# ---------------------------------------------------------------------------
# PORT=3000

# Bearer token required in Authorization header: "Bearer <token>"
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Protections (optional, defaults shown)
# ---------------------------------------------------------------------------
# Max queries per minute across all environments (rate limiter sliding window)
RATE_LIMIT_PER_MINUTE=60
# Max query execution time in milliseconds (PostgreSQL statement_timeout)
QUERY_TIMEOUT_MS=30000
# Max rows returned when no LIMIT clause is provided (auto-injected)
MAX_ROWS=1000

# ---------------------------------------------------------------------------
# Staging
# ---------------------------------------------------------------------------
POSTGRES_STAGING_HOST=your-staging-cluster.rds.amazonaws.com
POSTGRES_STAGING_PORT=5432
POSTGRES_STAGING_DATABASE=staging_mydb
POSTGRES_STAGING_USER=reader_staging
POSTGRES_STAGING_PASSWORD=
# POSTGRES_STAGING_SCHEMA=myschema  # optional: restrict to a single schema; omit to access all schemas
POSTGRES_STAGING_SSL=true

# ---------------------------------------------------------------------------
# Test
# ---------------------------------------------------------------------------
POSTGRES_TEST_HOST=your-test-cluster.rds.amazonaws.com
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_DATABASE=test_mydb
POSTGRES_TEST_USER=reader_test
POSTGRES_TEST_PASSWORD=
# POSTGRES_TEST_SCHEMA=myschema  # optional: restrict to a single schema; omit to access all schemas
POSTGRES_TEST_SSL=true

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
POSTGRES_PROD_HOST=your-prod-cluster.rds.amazonaws.com
POSTGRES_PROD_PORT=5432
POSTGRES_PROD_DATABASE=mydb
POSTGRES_PROD_USER=reader
POSTGRES_PROD_PASSWORD=
# POSTGRES_PROD_SCHEMA=myschema  # optional: restrict to a single schema; omit to access all schemas
POSTGRES_PROD_SSL=true
